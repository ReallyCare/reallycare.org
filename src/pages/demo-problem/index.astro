---
import Base from '../../layouts/Base.astro';
---
<Base title="Something went wrong | ReallyCare" description="Your demo request could not be sent.">
  <section class="section">
    <div class="wrap center">
      <span class="eyebrow">Demo request</span>
      <h1>Sorry, your request didn't go through</h1>
      <p class="lede">Please email us at <a href="mailto:contact-now@reallycare.org">contact-now@reallycare.org</a> and we'll arrange your demo.</p>
      <div class="cta-row" style="justify-content:center">
        <a href="/#demo" class="btn btn-ghost">Try the form again</a>
      </div>
    </div>
  </section>
</Base>
