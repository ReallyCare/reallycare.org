---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | ReallyCare" description="Sorry, we couldn't find that page.">
  <section class="section">
    <div class="wrap center">
      <span class="eyebrow">404</span>
      <h1>We couldn't find that page</h1>
      <p class="lede">It may have moved when we rebuilt our website.</p>
      <div class="cta-row" style="justify-content:center">
        <a href="/" class="btn btn-primary">Go to the home page</a>
        <a href="/plait/" class="btn btn-ghost">See Plait's features</a>
      </div>
    </div>
  </section>
</Base>
