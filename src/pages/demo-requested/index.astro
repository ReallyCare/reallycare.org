---
import Base from '../../layouts/Base.astro';
---
<Base title="Thank you | ReallyCare" description="Your demo request has been sent.">
  <section class="section">
    <div class="wrap center">
      <span class="eyebrow">Demo requested</span>
      <h1>Thank you. We'll be in touch soon.</h1>
      <p class="lede">We've received your request and will contact you to arrange a time.</p>
      <div class="cta-row" style="justify-content:center">
        <a href="/plait/" class="btn btn-primary">Explore Plait's features</a>
        <a href="/pricing/" class="btn btn-ghost">See pricing</a>
      </div>
    </div>
  </section>
</Base>
