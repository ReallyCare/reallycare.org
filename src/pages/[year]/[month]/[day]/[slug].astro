---
import { render } from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import CtaBand from '../../../../components/CtaBand.astro';
import { getPosts, postPath, postDate, excerpt, type Post } from '../../../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => {
    const [, year, month, day, slug] = postPath(post).split('/');
    return { params: { year, month, day, slug }, props: { post } };
  });
}

const { post } = Astro.props as { post: Post };
const { Content } = await render(post);
const isOld = post.data.date.getUTCFullYear() < new Date().getUTCFullYear() - 2;
---
<Base title={`${post.data.title} | ReallyCare blog`} description={post.data.description ?? excerpt(post, 155)}>
  <article class="section post">
    <div class="wrap narrow">
      <a href="/blog/" class="back">← All posts</a>
      <header>
        <p class="meta">
          <time datetime={post.data.date.toISOString()}>{postDate(post)}</time>
          {post.data.categories[0] && <span> · {post.data.categories[0]}</span>}
        </p>
        <h1>{post.data.title}</h1>
      </header>
      {isOld && (
        <p class="archive-note">This post is from our archive, so some details may be out of date. For the latest on Plait, see <a href="/plait/">our features</a>.</p>
      )}
      <div class="prose"><Content /></div>
      {post.data.tags.length > 0 && (
        <ul class="tags">{post.data.tags.map((t) => <li>{t}</li>)}</ul>
      )}
    </div>
  </article>
  <CtaBand />
</Base>

<style>
  .narrow { max-width: 760px; }
  .back { font-weight: 700; text-decoration: none; font-size: .95rem; }
  header { margin: 32px 0; }
  .meta { color: var(--ink-soft); font-size: .95rem; margin-bottom: 12px; }
  h1 { font-size: clamp(2rem, 4.4vw, 3.2rem); }
  .archive-note { background: var(--surface-alt); border-left: 3px solid var(--accent); padding: 12px 16px; border-radius: var(--radius-sm); font-size: .95rem; color: var(--ink-soft); }
  .tags { list-style: none; padding: 0; margin: 40px 0 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .tags li { font-size: .85rem; padding: 4px 12px; border-radius: 999px; background: var(--magenta-soft); color: var(--magenta); font-weight: 600; }
</style>
