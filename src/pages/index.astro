---
import Base from '../layouts/Base.astro';
import HeroVisual from '../components/HeroVisual.astro';
import PriceCalculator from '../components/PriceCalculator.astro';
import { officeFeatures } from '../data/features';

const homeIds = ['scheduling', 'care-planning', 'emar', 'finance', 'training-hr', 'compliance'];
const features = homeIds.map((id) => officeFeatures.find((f) => f.id === id)!);

const audiences = [
  { title: 'The office', text: 'Rostering, care planning, finance and compliance in one place, so the same data is never typed twice.' },
  { title: 'Care workers', text: 'Rotas, care plans with recent changes highlighted, medication and tasks on their phone. Secure messaging replaces WhatsApp.' },
  { title: 'Families & paramedics', text: 'Families see upcoming visits and visit notes. Paramedics can see the medication record in an emergency, and every access is logged.' },
];

const badges = [
  { src: '/img/ISO9001_27001.png', alt: 'ISO 9001 and ISO 27001 certified' },
  { src: '/img/ceplus.webp', alt: 'Cyber Essentials Plus' },
  { src: '/img/dspt_img.png', alt: 'NHS Data Security and Protection Toolkit' },
  { src: '/img/PRSB-Partner-Logo.png', alt: 'PRSB partner' },
  { src: '/img/SEUK.png', alt: 'Certified Social Enterprise' },
];
---
<Base
  title="Plait: homecare management software from ReallyCare"
  description="Rostering, care planning, eMAR, payroll and invoicing for domiciliary care in one system. no more than 15p per care hour, from a not-for-profit CIC."
>
  <!-- HERO -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">Homecare management software</span>
        <h1>Built by people who have been homecare providers.</h1>
        <p class="lede">
          Plait puts rostering, care planning, eMAR, payroll and invoicing in one system,
          used by the office, care workers and families.
        </p>
        <div class="cta-row">
          <a href="#demo" class="btn btn-primary">Book a demo →</a>
          <a href="#pricing" class="btn btn-ghost">Max 15p per care hour</a>
        </div>
        <p class="small-print">From ReallyCare, a not-for-profit CIC with no investors to answer to.</p>
      </div>
      <HeroVisual />
    </div>
  </section>

  <!-- TRUST STRIP -->
  <section class="trust" aria-label="Certifications and memberships">
    <div class="wrap">
      <p>Certified and trusted with sensitive care data</p>
      <ul>
        {badges.map((b) => <li><img src={b.src} alt={b.alt} loading="lazy" /></li>)}
      </ul>
    </div>
  </section>

  <!-- FEATURES -->
  <section class="section">
    <div class="wrap">
      <div class="center intro">
        <span class="eyebrow">One system</span>
        <h2>Everything a homecare provider needs</h2>
        <p class="lede">No bolt-ons and no second login. Every part of Plait works from the same records.</p>
      </div>
      <div class="features">
        {features.map((f) => (
          <a class="card" href={`/plait/#${f.id}`}>
            <span class="icon" aria-hidden="true">{f.icon}</span>
            <h3>{f.title}</h3>
            <p>{f.summary}</p>
          </a>
        ))}
      </div>
      <p class="center more"><a href="/plait/">See every feature →</a></p>
    </div>
  </section>

  <!-- AUDIENCES -->
  <section class="section alt">
    <div class="wrap split">
      <div>
        <span class="eyebrow">Point of care</span>
        <h2>The office, care workers and families use the same records</h2>
        <p class="lede">The office manages the service, care workers use the phone app at each visit, and families can see what is happening.</p>
        <img src="/img/med-last-taken.png" alt="Plait point-of-care medication screen showing when a dose was last taken" class="shot" loading="lazy" />
      </div>
      <ol class="audiences">
        {audiences.map((a, i) => (
          <li>
            <span class="num">{i + 1}</span>
            <div><h3>{a.title}</h3><p>{a.text}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- WHY US -->
  <section class="section dark">
    <div class="wrap">
      <div class="intro">
        <span class="eyebrow light">Why ReallyCare</span>
        <h2>What makes ReallyCare different</h2>
      </div>
      <div class="why">
        <div>
          <strong class="big">Since 1987</strong>
          <p>Our founder has built care software since 1987, and co-ran a domiciliary care provider for several years.</p>
        </div>
        <div>
          <strong class="big">Not for profit</strong>
          <p>As a community interest company, our profits go back into Plait and into the care sector. We have no investors to answer to.</p>
        </div>
        <div>
          <strong class="big">Open standards</strong>
          <p>As a PRSB partner, Plait supports the <em>About Me</em> and <em>Personalised Care and Support Plan</em> standards. We plan to open-source Plait in time.</p>
        </div>
      </div>
      <figure class="quote">
        <blockquote>“Thanks for all your help &amp; advice. A1 customer service from ReallyCare once again.”</blockquote>
        <figcaption>James Dwyer, Managing Director, Pineshield Care, Cardiff · <a href="/customers/">More customer stories →</a></figcaption>
      </figure>
    </div>
  </section>

  <!-- PRICING -->
  <section class="section" id="pricing">
    <div class="wrap split pricing">
      <div>
        <span class="eyebrow">Pricing</span>
        <h2>Never more than <span class="hl">15p</span> per care hour</h2>
        <p class="lede">You pay for the care hours you deliver, and longer visits such as sleepovers cost less. There are no per-user fees, no per-module fees, no setup fee and no contract. The minimum charge is £75 a month.</p>
        <p>If you'd like help getting set up, we offer paid setup assistance.</p>
        <p><a href="/pricing/">Full pricing details →</a></p>
      </div>
      <PriceCalculator />
    </div>
  </section>

  <!-- DEMO -->
  <section class="section alt" id="demo">
    <div class="wrap split">
      <div>
        <span class="eyebrow">Book a demo</span>
        <h2>See Plait with your own scenarios</h2>
        <p class="lede">Start with a 45-minute walkthrough with someone who has run a care service. There are no sales scripts.</p>
        <p>Prefer email? Write to <a href="mailto:contact-now@reallycare.org">contact-now@reallycare.org</a></p>
      </div>
      <form class="card form" method="post" action="/api/demo">
        <label>Your name <input name="name" required maxlength="100" autocomplete="name" /></label>
        <label>Work email <input name="email" type="email" required maxlength="200" autocomplete="email" /></label>
        <label>Organisation <input name="org" maxlength="200" autocomplete="organization" /></label>
        <label>Phone <input name="phone" type="tel" maxlength="40" autocomplete="tel" /></label>
        <label>Anything we should know? <textarea name="message" rows="3" maxlength="4000"></textarea></label>
        <!-- Bot trap: hidden from people, so anything typed here is from a bot -->
        <label class="hp" aria-hidden="true">Website <input name="website" tabindex="-1" autocomplete="off" /></label>
        <button class="btn btn-primary" type="submit">Request a demo</button>
      </form>
    </div>
  </section>

</Base>

<style>
  .hero { background: var(--hero-bg); padding-block: clamp(48px, 8vw, 96px) clamp(56px, 8vw, 104px); }
  .hero-grid { display: grid; grid-template-columns: 1fr 1.15fr; gap: clamp(32px, 5vw, 72px); align-items: center; }
  @media (max-width: 960px) { .hero-grid { grid-template-columns: 1fr; } }
  .small-print { font-size: .9rem; color: var(--ink-soft); }

  .trust { border-block: 1px solid var(--line); background: var(--surface); padding-block: 28px; }
  .trust p { text-align: center; font-size: .8rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-soft); margin-bottom: 20px; }
  .trust ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: clamp(10px, 2vw, 18px); }
  .trust li { background: var(--badge-bg); border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 10px 14px; display: grid; place-items: center; height: 76px; }
  .trust img { max-height: 54px; width: auto; max-width: 120px; object-fit: contain; }

  .features { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 20px; }
  .features .card { transition: transform .2s, box-shadow .2s; }
  .features .card:hover { transform: translateY(-3px); box-shadow: var(--shadow); }
  .features .card { color: inherit; text-decoration: none; }
  .features p { color: var(--ink-soft); margin: 0; }
  .more { margin-top: 32px; font-weight: 700; }
  .more a { text-decoration: none; }

  .audiences { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  .audiences li { display: flex; gap: 20px; background: var(--surface); border-radius: var(--radius); padding: 24px; border: 1px solid var(--line); }
  .audiences p { margin: 0; color: var(--ink-soft); }
  .num { flex: none; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--brand); color: #fff; font-weight: 800; }

  .dark { background: var(--dark-band); color: rgb(255 255 255 / .82); }
  .dark h2 { color: #fff; max-width: 22ch; }
  .eyebrow.light { color: #ff8cc6; }
  .why { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 40px; }
  .big { display: block; font-family: var(--font-display); font-weight: var(--display-weight); font-size: 1.9rem; color: #fff; margin-bottom: 8px; letter-spacing: var(--display-tracking); }
  .quote { margin: 64px 0 0; padding-top: 40px; border-top: 1px solid rgb(255 255 255 / .15); }
  .quote blockquote { margin: 0 0 12px; font-family: var(--font-display); font-size: clamp(1.4rem, 2.6vw, 2rem); color: #fff; line-height: 1.3; }
  .quote figcaption { font-size: .95rem; }
  .quote a { color: #ff8cc6; }

  .hl { color: var(--magenta); }

  .form { display: grid; gap: 14px; box-shadow: var(--shadow); }
  .form label { display: grid; gap: 6px; font-weight: 600; font-size: .95rem; }
  .form input, .form textarea {
    font: inherit; padding: 12px 14px; border-radius: var(--radius-sm);
    border: 1px solid var(--line); background: var(--bg); color: var(--ink); width: 100%;
  }
  .form input:focus, .form textarea:focus { outline: 2px solid var(--magenta); outline-offset: 0; border-color: transparent; }
  .form .btn { justify-content: center; margin-top: 6px; }
</style>
