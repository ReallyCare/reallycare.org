---
// Real Plait screenshots (demo data): the office rota, with the care worker app on top.
---
<div class="visual">
  <div class="window">
    <div class="chrome" aria-hidden="true"><i></i><i></i><i></i><span>Plait · Plan</span></div>
    <img
      src="/img/screenshots/plan.webp"
      alt="The Plait rota for one day, showing care workers grouped by area with their visits laid out across the day"
      width="1100" height="815"
    />
  </div>

  <div class="phone">
    <div class="notch" aria-hidden="true"></div>
    <img
      src="/img/screenshots/event-list.webp"
      alt="The care worker app's list of today's visits, with completed visits ticked and medication due on later ones"
      width="414" height="929"
    />
  </div>
</div>

<style>
  .visual { position: relative; padding: 0 0 40px; }
  .window {
    background: var(--surface); border-radius: var(--radius); box-shadow: var(--shadow);
    border: 1px solid var(--line); overflow: hidden; font-size: 12px; line-height: 1.3;
  }
  .chrome { display: flex; gap: 6px; align-items: center; padding: 10px 14px; border-bottom: 1px solid var(--line); background: var(--surface-alt); }
  .chrome i { width: 10px; height: 10px; border-radius: 50%; background: var(--line); }
  .chrome span { margin-left: 10px; color: var(--ink-soft); font-weight: 600; }
  .window img { display: block; width: 100%; height: auto; }

  .phone {
    position: absolute; right: -10px; bottom: 0; width: 170px;
    background: #111; border-radius: 28px; padding: 10px; box-shadow: var(--shadow);
  }
  .notch { width: 60px; height: 6px; background: #333; border-radius: 99px; margin: 2px auto 8px; }
  .phone img { display: block; width: 100%; height: auto; border-radius: 18px; }

  @media (max-width: 640px) {
    .phone { width: 120px; right: -4px; }
  }
</style>
