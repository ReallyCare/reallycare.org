---
const links = [
  { href: '/plait/', label: 'Plait' },
  { href: '/pricing/', label: 'Pricing' },
  { href: '/why-reallycare/', label: 'Why ReallyCare' },
  { href: '/customers/', label: 'Customers' },
  { href: '/about/', label: 'About' },
];
---
<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="brand" aria-label="ReallyCare home">
      <img src="/img/transparent_logo.png" alt="reallycare CIC" width="160" height="54" />
    </a>
    <div class="tools">
    <nav class="desktop" aria-label="Main">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
      <a href="https://www.plaitapp.org" class="login">Log in</a>
      <a href="/#demo" class="btn btn-primary">Book a demo</a>
    </nav>
    <details class="menu">
      <summary aria-label="Menu"><span></span><span></span><span></span></summary>
      <nav aria-label="Main (mobile)">
        {links.map((l) => <a href={l.href}>{l.label}</a>)}
        <a href="https://www.plaitapp.org" class="login">Log in</a>
        <a href="/#demo" class="btn btn-primary">Book a demo</a>
      </nav>
    </details>
    <button class="theme-toggle" type="button" aria-label="Switch between light and dark mode">
      <svg class="moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
      <svg class="sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="currentColor"/><g stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></g></svg>
    </button>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;
  const isDark = () =>
    root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
  document.querySelector('.theme-toggle')!.addEventListener('click', () => {
    const next = isDark() ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
  });
</script>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 72px; }
  .brand img { width: 150px; height: auto; }
  nav { display: flex; align-items: center; gap: clamp(14px, 2vw, 28px); }
  nav a { color: var(--ink); text-decoration: none; font-weight: 600; font-size: .95rem; }
  nav a:not(.btn):hover { color: var(--magenta); }
  nav .login { color: var(--ink-soft); }
  nav .btn { padding: .6em 1.15em; color: #fff; }

  .tools { display: flex; align-items: center; gap: clamp(8px, 1.5vw, 20px); }
  .theme-toggle {
    display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%;
    border: 1px solid var(--line); background: var(--surface); color: var(--ink); cursor: pointer;
  }
  .theme-toggle:hover { border-color: var(--ink-soft); }
  /* Show the icon for the theme you'd switch to */
  .theme-toggle .sun { display: none; }
  :global(:root[data-theme='dark']) .theme-toggle .sun { display: block; }
  :global(:root[data-theme='dark']) .theme-toggle .moon { display: none; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .theme-toggle .sun { display: block; }
    :global(:root:not([data-theme='light'])) .theme-toggle .moon { display: none; }
  }
  /* The magenta logo needs lifting on dark backgrounds */
  :global(:root[data-theme='dark']) .brand img { filter: brightness(1.45) saturate(.9); }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .brand img { filter: brightness(1.45) saturate(.9); }
  }
  .menu { display: none; }
  /* Mobile: details/summary gives a no-JS hamburger */
  @media (max-width: 960px) {
    .desktop { display: none; }
    .menu { display: block; }
    .menu summary {
      display: grid; gap: 5px; place-content: center;
      width: 44px; height: 44px; cursor: pointer; list-style: none;
    }
    .menu summary::-webkit-details-marker { display: none; }
    .menu summary span { display: block; width: 22px; height: 2px; background: var(--ink); border-radius: 2px; }
    .menu nav {
      position: absolute; left: 0; right: 0; top: 72px;
      flex-direction: column; align-items: stretch; gap: 0;
      background: var(--surface); border-bottom: 1px solid var(--line);
      padding: 8px var(--gutter) 20px; box-shadow: var(--shadow);
    }
    .menu nav a:not(.btn) { padding: 14px 0; border-bottom: 1px solid var(--line); }
    .menu nav .btn { margin-top: 16px; justify-content: center; }
  }
</style>
