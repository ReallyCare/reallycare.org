---
// Click-to-play YouTube embed. Nothing loads from YouTube until the visitor
// clicks, so there are no third-party cookies and no cookie banner is needed.
interface Props { id: string; title: string; poster: string; }
const { id, title, poster } = Astro.props;
---
<div class="video" data-id={id} data-title={title}>
  <button type="button" aria-label={`Play video: ${title}`}>
    <img src={poster} alt="" loading="lazy" width="1280" height="720" />
    <span class="play" aria-hidden="true">▶</span>
  </button>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.video').forEach((el) => {
    el.querySelector('button')!.addEventListener('click', () => {
      const frame = document.createElement('iframe');
      frame.src = `https://www.youtube-nocookie.com/embed/${el.dataset.id}?autoplay=1&rel=0`;
      frame.title = el.dataset.title ?? '';
      frame.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      frame.allowFullscreen = true;
      el.replaceChildren(frame);
    });
  });
</script>

<style>
  .video { position: relative; aspect-ratio: 16 / 9; border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow); background: #000; }
  .video button { all: unset; cursor: pointer; display: block; width: 100%; height: 100%; position: relative; }
  .video img { width: 100%; height: 100%; object-fit: cover; }
  .video :global(iframe) { width: 100%; height: 100%; border: 0; }
  .play {
    position: absolute; inset: 0; margin: auto; width: 84px; height: 84px; border-radius: 50%;
    display: grid; place-items: center; padding-left: 6px;
    background: var(--brand); color: #fff; font-size: 30px; box-shadow: 0 8px 24px rgb(0 0 0 / .35);
    transition: transform .15s;
  }
  .video button:hover .play, .video button:focus-visible .play { transform: scale(1.08); }
</style>
